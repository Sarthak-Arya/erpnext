# Copy to .env on the server and replace every CHANGE_ME before first start.
#   cp .env.example .env
#
# Compose loads this file automatically. COMPOSE_FILE lists the official
# Frappe Docker files plus the Caddy/proxy network override.

COMPOSE_PROJECT_NAME=erpnext

# --- Versions (official frappe_docker example.env + overrides) ---
# ERPNext image tag. Frappe is the version bundled in this image
# (ERPNext 16 requires Frappe >=16.21.0,<17). Do not mix v15 images with v16.
ERPNEXT_VERSION=v16.32.3
# MariaDB image is pinned in overrides/compose.mariadb.yaml: mariadb:11.8
# Redis image is pinned in overrides/compose.redis.yaml: redis:8.6-alpine

PULL_POLICY=always
RESTART_POLICY=unless-stopped

# Leave empty to use frappe/erpnext:${ERPNEXT_VERSION}.
# Set these only if you built a custom image (e.g. Lumina theme).
CUSTOM_IMAGE=
CUSTOM_TAG=

# --- MariaDB (consumed by official override) ---
# Official Frappe Docker uses MariaDB *root* only. `bench new-site` creates
# the site database and application user. Do not point this stack at the
# existing PostgreSQL 16/17 containers.
#
# MYSQL_DATABASE / MYSQL_USER / MYSQL_PASSWORD are NOT used by Frappe Docker.
# Setting them would create an unused schema and would not be the site DB.
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# --- Site (used by the new-site command, not interpolated into Compose) ---
SITE_NAME=erp.flipswitch.in
ADMIN_PASSWORD=CHANGE_ME

# Resolve site from Host header (erp.flipswitch.in). Leave empty.
FRAPPE_SITE_NAME_HEADER=

# --- Gunicorn ---
GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# --- Frontend nginx (behind existing Caddy on Docker network `proxy`) ---
# Trust Docker/Caddy addresses so X-Forwarded-For from Cloudflare is used.
UPSTREAM_REAL_IP_ADDRESS=172.16.0.0/12
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=on
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

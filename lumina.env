# Production overlay for the Lumina CRM image.
# Usage:
#   docker compose --env-file lumina.env -f compose.yaml -f overrides/compose.mariadb.yaml -f overrides/compose.redis.yaml -f overrides/compose.noproxy.yaml config > compose.lumina.yaml
#   docker compose -p lumina -f compose.lumina.yaml up -d

CUSTOM_IMAGE=lumina-crm
CUSTOM_TAG=v16.32.3
PULL_POLICY=never
ERPNEXT_VERSION=v16.32.3
DB_PASSWORD=admin
HTTP_PUBLISH_PORT=8081
FRAPPE_SITE_NAME_HEADER=frontend
